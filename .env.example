# Copy to .env. This file is deliberately ignored by Git.
# Create an OpenRouter API key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# The bootstrap script fills these with strong random values if they are blank.
POSTGRES_PASSWORD=
OMNIGENT_ACCOUNTS_COOKIE_SECRET=

# Set a long unique password before exposing this service to the family.
OMNIGENT_ACCOUNTS_INIT_ADMIN_PASSWORD=

# Local test only. Change to the private HTTPS URL before Home Assistant deployment.
OMNIGENT_ACCOUNTS_BASE_URL=http://localhost:8000
OMNIGENT_PORT=8000

# Pin this to a tested release before the Home Assistant deployment.
OMNIGENT_IMAGE=ghcr.io/omnigent-ai/omnigent-server
OMNIGENT_IMAGE_TAG=latest
